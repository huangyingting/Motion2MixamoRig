# ── User-supplied assets: never committed ───────────────────
# Ignore every file under assets/; re-include directories (so git
# can descend) plus the docs and .gitkeep placeholders. This keeps
# SMPLX_NEUTRAL.npz / *.fbx / videos out of git no matter what.
assets/**
!assets/**/
!assets/README.md
!assets/**/.gitkeep
/mano_v1_2.zip
/smplh.tar.xz

# ── Auto-downloaded inference weights (GVHMR / 2D pose, etc.) ─
weights/**
!weights/.gitkeep

# ── Run outputs ──────────────────────────────────────────────
outputs/**
!outputs/.gitkeep

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# ── Local secrets / environment variables ────────────────────
.env
.env.*

# ── Local tests and editor junk: not committed ───────────────
tests/*
!tests/test_model_extractors.py
!tests/test_source_metadata.py
!tests/test_bvh.py
!tests/test_person_tracking.py
scripts/verify_blender_addon.py
:memory:.ses

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
yt2bvh.sh
